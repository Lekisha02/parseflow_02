# Server-side only. Never sent to the browser. ParseFlow runs fully offline without any of these keys:
# text layer + tables + equations (digital PDFs) + Tesseract OCR. Without a vision key, handwriting,
# hand-drawn diagrams and charts are preserved and flagged, not read.
VISION_API_KEY=
# Pick ONE provider:
#   VISION_PROVIDER=anthropic   -> key from console.anthropic.com   (default model claude-sonnet-5-5)
#   VISION_PROVIDER=gemini      -> key from aistudio.google.com     (default model gemini-3.5-flash)
VISION_PROVIDER=anthropic
VISION_MODEL=
MAX_VISION_REGIONS=12
# 0 = no limit. Very large documents (2,000+ pages) are processed page by page in a separate worker process,
# so they take longer but do not crash the server.
MAX_PAGES=0
MAX_UPLOAD_MB=0

# Ask assistant (answers questions about the document, explains terms/equations, summarises).
# Without a provider it still works offline: it quotes the most relevant passages with page numbers.
#   ASK_PROVIDER=anthropic | gemini | openai | ollama | none   (empty: reuse the vision provider when VISION_API_KEY is set)
#   ASK_PROVIDER=ollama runs fully offline with a local model (ollama pull llama3.1), no key needed.
#   ASK_PROVIDER=openai + ASK_BASE_URL works with any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, Groq, OpenRouter ...)
ASK_PROVIDER=
ASK_API_KEY=
ASK_MODEL=
ASK_BASE_URL=
ASK_TIMEOUT=120
# Send the image of a selected figure/diagram/table to the model (Ask about this block).
# auto = on for anthropic, gemini and OpenAI's own API; set 1 for a local vision model (e.g. ollama llava), 0 = never.
ASK_VISION=auto
# Long-document summaries: text per part, parts summarised at once, maximum number of parts.
ASK_SECTION_CHARS=6000
ASK_PARALLEL=4
ASK_SUMMARY_PARTS=40
# Optional meaning-based retrieval with a neural embedding model (any OpenAI-compatible /embeddings endpoint).
# Retrieval already uses keywords + LSA over the document itself; this adds a model. Offline: ollama pull nomic-embed-text
ASK_EMBED_MODEL=
ASK_EMBED_BASE_URL=
ASK_EMBED_API_KEY=

# OCR (Tesseract)
OCR_LANG=eng
OCR_TIMEOUT=60
OCR_MAX_ATTEMPTS=2

# Exclude confidently detected running headers/footers/page numbers from the Markdown (kept in JSON)
PARSEFLOW_REMOVE_FURNITURE=1

# Optional local formula recognizer for SCANNED equations: none | pix2tex | rapid_latex_ocr | command
# Weights are never downloaded automatically; put them in PARSEFLOW_MATH_MODEL_DIR.
PARSEFLOW_MATH_RECOGNIZER=none
PARSEFLOW_MATH_MODEL_DIR=
PARSEFLOW_MATH_CMD=

# Optional local models (never downloaded; put weights in PARSEFLOW_MODEL_DIR). See README "Local models".
# PARSEFLOW_OCR_ENGINE: tesseract | paddleocr | surya | command
PARSEFLOW_OCR_ENGINE=tesseract
PARSEFLOW_OCR_CMD=
# PARSEFLOW_HANDWRITING: none | trocr | command
PARSEFLOW_HANDWRITING=none
PARSEFLOW_HANDWRITING_CMD=
# PARSEFLOW_CHART_MODEL: none | deplot | command   (charts drawn as vectors are read without any model)
PARSEFLOW_CHART_MODEL=none
PARSEFLOW_CHART_CMD=
PARSEFLOW_MODEL_DIR=

# API storage / housekeeping
# Guest uploads expire after this many hours; documents saved to an account are kept until deleted
PARSEFLOW_JOB_TTL_HOURS=24
PARSEFLOW_SESSION_DAYS=30
# Set to 1 when ParseFlow is served over HTTPS
PARSEFLOW_SECURE_COOKIE=0
PARSEFLOW_WORKERS=2
# Run each document in its own worker process (a crash or out-of-memory in one document cannot take the server down)
PARSEFLOW_ISOLATE=1
# Optional per-document time limit in seconds (empty = none)
PARSEFLOW_JOB_TIMEOUT=
# Memory one worker may use (MB, or auto = 80% of this machine/container shared by the workers, at least 1.5 GB; 0 = no cap)
PARSEFLOW_WORKER_MEMORY_MB=auto
# A worker that dies or runs out of memory is retried this many times, with smaller page slices, from its last checkpoint
PARSEFLOW_RETRIES=1
# Save every finished slice of pages so a stopped job resumes where it was (also after a server restart)
PARSEFLOW_CHECKPOINT=1
PARSEFLOW_RESUME=1
# The viewer opens documents whose JSON is larger than this (MB) from a light copy and loads details on demand
PARSEFLOW_LITE_MB=8

# Accounts: email confirmation and password reset
# Address users open ParseFlow at (used in emailed links). Set it in production.
PARSEFLOW_PUBLIC_URL=
# 1 = users must confirm their email before they can log in
PARSEFLOW_REQUIRE_VERIFIED=0
# Without SMTP_HOST, emails are written to <data dir>/outbox/ and printed in the server log instead of being sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURITY=starttls
# Guest uploads are private to the browser that uploaded them until shared; 'open' = anyone with the id (old behaviour)
PARSEFLOW_GUEST_LINKS=private
# 1 only behind a reverse proxy you control (uses X-Forwarded-Host/-Proto for links)
PARSEFLOW_TRUST_PROXY=0
# PostgreSQL instead of the built-in SQLite file (several servers, one database): pip install -r requirements-postgres.txt
DATABASE_URL=
